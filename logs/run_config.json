{
  "seed": 42,
  "data_dir": "data/NFBS",
  "split_file": "splits/split.json",
  "cache_dir": "cache",
  "checkpoint_dir": "checkpoints",
  "log_dir": "logs",
  "results_dir": "results",
  "device": "cuda",
  "model": {
    "channels": [
      16,
      32,
      64,
      128,
      256
    ],
    "strides": [
      2,
      2,
      2,
      2
    ],
    "num_res_units": 2
  },
  "train": {
    "roi_size": [
      96,
      96,
      96
    ],
    "batch_size": 2,
    "num_samples": 2,
    "num_workers": 2,
    "learning_rate": 0.0001,
    "weight_decay": 1e-05,
    "max_epochs": 200,
    "val_interval": 5,
    "patience_epochs": 30,
    "amp": true,
    "cpu_threads": 4
  },
  "infer": {
    "roi_size": [
      96,
      96,
      96
    ],
    "sw_batch_size": 2,
    "overlap": 0.5,
    "blend_mode": "constant"
  },
  "postprocess": {
    "connectivity": 1
  },
  "bet": {
    "executable": "bet",
    "fractional_threshold": 0.5
  }
}
